<%#
# Application Layout

This view template is used as the layout
for every page that Administrate generates.

By default, it renders:
- Navigation
- Content for a search bar
  (if provided by a `content_for` block in a nested page)
- Flashes
- Links to stylesheets and JavaScripts
%>

<!DOCTYPE html>
<html lang="<%= I18n.locale %>" class="w-full h-full">
<head>
  <meta charset="utf-8">
  <meta name="ROBOTS" content="NOODP">
  <meta name="viewport" content="initial-scale=1">
  <title>
    <%= content_for(:title) %> - <%= application_title %>
  </title>
  <%= render "stylesheet" %>
  <%= vite_client_tag %>
  <%= vite_javascript_tag 'superadmin' %>
  <%= csrf_meta_tags %>

  <style>
    :root {
      /* --- CORES PRINCIPAIS (Roxo GenIA) --- */
      --color-brand: #DB58F4 !important;
      --brand-color: #DB58F4 !important;
      --primary-color: #DB58F4 !important;
      --w-500: #DB58F4 !important;
      --w-600: #8e1bb3 !important; /* Hover escuro */
      --w-700: #6514BE !important; /* Active/Forte */
      --w-alpha-100: rgba(219, 88, 244, 0.1) !important;
      
      /* --- BARRA LATERAL E FUNDOS (Azul Noturno) --- */
      --s-900: #04034F !important;
      --s-800: #0d0c66 !important;
      --sidebar-bg: #04034F !important;
      --color-sidebar: #04034F !important;
    }

    /* 1. FORÇAR MENU LATERAL (SIDEBAR) */
    .app-wrapper .sidebar, aside.sidebar, .sidebar-wrap { 
      background-color: var(--s-900) !important; 
      border-right: 1px solid var(--s-800) !important;
    }
    
    /* 2. FORÇAR BOTÕES (ROXOS) */
    .button.primary, .btn-primary, .button.success, button[type="submit"], .submit-button { 
      background-color: var(--w-500) !important; 
      border-color: var(--w-500) !important; 
      color: #ffffff !important;
    }
    .button.primary:hover, .btn-primary:hover, button[type="submit"]:hover { 
      background-color: var(--w-600) !important; 
    }
    
    /* 3. FORÇAR LINKS */
    a, .link, .text-link { color: var(--w-500) !important; }
    
    /* 4. ESCONDER MARCA CHATWOOT */
    .chatwoot-branding, .branding--link, .footer-links { display: none !important; }
  </style>
</head>
<body class="antialiased w-full h-full">
  <%= render "icons" %>
  <div class="flex w-full h-full">
    <%= render "navigation" -%>
    <main class="w-full overflow-auto" role="main">
      <%= render "flashes" -%>
      <%= yield %>
    </main>
  </div>
  <%= render "javascript" %>
</body>
</html>
